# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_WORKER_THREADS=4

# Sandbox Configuration
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_CPU_TIME_SECS=30
SANDBOX_MAX_FILE_DESCRIPTORS=1024
SANDBOX_ENABLE_SECCOMP=true
SANDBOX_ENABLE_NAMESPACES=true

# Runtime Configuration
RUNTIME_PLUGGABLE_RUNTIMES=python,rust
RUNTIME_MAX_CONCURRENT_EXECUTIONS=100
RUNTIME_EXECUTION_TIMEOUT_SECS=30

# Logging Configuration
LOGGING_LEVEL=info
LOGGING_FORMAT=json
